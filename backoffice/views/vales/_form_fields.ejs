<div class="form-group">
    <label class="col-md-2 col-sm-3 col-xs-12 control-label">Nome</label>
    <div class="col-md-10 col-sm-9 col-xs-12">
      <input class="form-control" type="text" name="name" value="<%= vale ? vale.name : '' %>" required>
    </div>
  </div>
  
  <div class="form-group">
    <label class="col-md-2 col-sm-3 col-xs-12 control-label">Preço</label>
    <div class="col-md-10 col-sm-9 col-xs-12">
      <input class="form-control" type="number" name="price" value="<%= vale ? vale.price : '' %>" required>
    </div>
  </div>
  