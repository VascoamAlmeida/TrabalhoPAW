<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.1/css/all.min.css"
  integrity="sha256-2XFplPlrFClt0bIdPgpz8H7ojnk10H69xRqd9+uTShA="
  crossorigin="anonymous"
/>

<div class="container mt-3 mb-4">
  <h2 class="h3">Pesquisar Vale</h2>
  <form action="/vales" method="GET" class="d-flex">
    <div class="col-4">
      <label class="mr-3">Nome</label>
      <input
        class="form-control"
        type="text"
        name="name"
        value="<%= searchOptions.name %>"
      />
      <label class="mr-3">Preço</label>
      <input
        class="form-control"
        type="number"
        name="price"
        value="<%= searchOptions.price %>"
      />
    </div>
    <div class="col-2 d-flex justify-content-center align-items-center">
      <button class="btn btn-primary" type="submit">Pesquisar</button>
    </div>
    <div class="col-2 d-flex justify-content-center align-items-center">
      <a href="/vales/new" class="btn btn-success ml-auto">Adicionar Vale</a>
    </div>
  </form>
</div>

<br />

<div class="container mt-3 mb-4">
  <div class="col-lg-12 mt-4 mt-lg-0">
    <div class="row justify-content-center">
      <div class="col-md-12">
        <div
          class="user-dashboard-info-box table-responsive mb-0 bg-white p-4 shadow-sm"
        >
          <table class="table manage-candidates-top mb-0">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th class="action text-right">Ação</th>
              </tr>
            </thead>
            <tbody>
              <% vales.forEach(vale => { %>
              <tr class="candidates-list">
                <td class="candidate-list-favourite-time text-center">
                  <span class="candidate-list-time order-1"
                    ><%= vale.name %></span
                  >
                </td>
                <td class="candidate-list-favourite-time text-center">
                  <span class="candidate-list-time order-1"
                    ><%= vale.price %></span
                  >
                </td>
                <td>
                  <ul class="list-unstyled mb-0 d-flex justify-content-end">
                    <li class="mr-3">
                      <a
                        href="/vales/<%= vale.id %>"
                        class="text-primary"
                        data-toggle="tooltip"
                        title="Ver"
                        ><i class="far fa-eye"></i
                      ></a>
                    </li>
                    <li class="mr-3">
                      <a
                        href="/vales/<%= vale.id %>/edit"
                        class="text-info"
                        data-toggle="tooltip"
                        title="Editar"
                        ><i class="fas fa-pencil-alt"></i
                      ></a>
                    </li>
                    <li>
                      <%- include("../partials/deleteForm", { url:
                      `/vales/${vale.id}` }) %>
                    </li>
                  </ul>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
