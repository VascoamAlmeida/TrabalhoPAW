<div class="form-group">
  <label class="col-md-2 col-sm-3 col-xs-12 control-label">Doador</label>
  <div class="col-md-10 col-sm-9 col-xs-12">
    <select class="form-control" name="user">
      <% users.forEach(user => { %> <% if (user.id.toString() ===
      doacao.user.toString()) { %>
      <option selected label="<%= user.name %>" value="<%= user.id %>"></option>
      <% } else { %>
      <option label="<%= user.name %>" value="<%= user.id %>"></option>
      <% } %> <% }) %>
    </select>
  </div>
</div>

