<div class="form-group">
  <label for="estado" class="col-md-2 col-sm-3 col-xs-12 control-label">Estado</label>
  <div class="col-md-10 col-sm-9 col-xs-12">
    <select class="form-control" name="estado">
      <option <%= doacao.estado === 'Inicio' ? 'selected' : '' %>>Inicio</option>
      <option <%= doacao.estado === 'Curso' ? 'selected' : '' %>>Curso</option>
      <option <%= doacao.estado === 'Fim' ? 'selected' : '' %>>Fim</option>
      <option <%= doacao.estado === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
    </select>
  </div>
</div>

