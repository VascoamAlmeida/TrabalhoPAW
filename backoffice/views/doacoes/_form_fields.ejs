<div class="form-group">
  <label class="col-md-2 col-sm-3 col-xs-12 control-label">Data Doacao</label>
  <div class="col-md-10 col-sm-9 col-xs-12">
    <input
      class="form-control"
      type="date"
      name="data"
      value="<%= doacao.data == null ? '': 
            doacao.data.toISOString().split('T')[0] %>"
    />
    <!--Passar para String a data-->
  </div>
</div>

<!--INSERIR A QUANTIDADE DE DOACAO-->
<!-- <div>
  <label>Quantidade</label>
  <input type="number" name="quantidade" min="1" value="<%= doacao.quantidade  %>" />
</div> -->

<div class="form-group">
  <label class="col-md-2 col-sm-3 col-xs-12 control-label">Quantidade</label>
  <div class="col-md-10 col-sm-9 col-xs-12">
    <input
      class="form-control"
      type="number"
      name="quantidade"
      min="1"
      value="<%= doacao.quantidade  %>"
    />
  </div>
</div>

