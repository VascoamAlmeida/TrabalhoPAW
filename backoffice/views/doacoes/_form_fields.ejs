<div class="form-group">
  <label class="col-md-2 col-sm-3 col-xs-12 control-label">Entidade</label>
  <div class="col-md-10 col-sm-9 col-xs-12">
    <select class="form-control" name="entidade">
      <% entidades.forEach(entidade => { %> <% if (entidade.id.toString() ===
      doacao.entidade.toString()) { %>
      <option
        selected
        label="<%= entidade.name %>"
        value="<%= entidade.id %>"
      ></option>
      <% } else { %>

      <option label="<%= entidade.name %>" value="<%= entidade.id %>"></option>
      <% } %> <% }) %>
    </select>
  </div>
</div>

