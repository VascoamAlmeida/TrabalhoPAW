<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.1/css/all.min.css"
  integrity="sha256-2XFplPlrFClt0bIdPgpz8H7ojnk10H69xRqd9+uTShA="
  crossorigin="anonymous"
/>

<div class="container mt-3 mb-4">
  <h2 class="h3">Search Entidades</h2>
  <form action="/entidades" method="GET" class="d-flex">
    <label class="mr-3">Name</label>
    <input
      class="form-control col-2"
      type="text"
      name="name"
      value="<%= searchOptions.name %>"
    />
    <label class="mr-3">Localizacao</label>
    <input
      class="form-control col-2"
      type="text"
      name="localizacao"
      value="<%= searchOptions.localizacao %>"
    />
    <label class="mr-3">Aprovada</label>
    <input
      class="form-control col-2"
      type="text"
      name="aprovada"
      value="<%= searchOptions.aprovada %>"
    />
    <button class="btn btn-primary" type="submit">Search</button>
    <a href="/entidades/new" class="btn btn-success ml-auto w-25"
      >Add Entidade</a
    >
  </form>
</div>

<br />

<div class="container mt-3 mb-4">
  <div class="col-lg-12 mt-4 mt-lg-0">
    <div class="row justify-content-center">
      <div class="col-md-12">
        <div
          class="user-dashboard-info-box table-responsive mb-0 bg-white p-4 shadow-sm"
        >
          <table class="table manage-candidates-top mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Localizacao</th>
                <th>Aprovada</th>
                <th class="action text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% entidades.forEach (entidade => { %>
              <tr class="candidates-list">
                <td class="title">
                  <div class="thumb">
                    <img
                      style="width: 80px; height: 80px"
                      class="img-fluid"
                      src="<%= entidade.logoImagePath %>"
                      alt=""
                    />
                  </div>
                  <div class="candidate-list-details">
                    <div class="candidate-list-info">
                      <div class="candidate-list-title">
                        <h5 class="mb-0">
                          <a href="/entidades/<%= entidade.id %>"
                            ><%= entidade.name %></a
                          >
                        </h5>
                      </div>
                    </div>
                  </div>
                </td>
                <td><%= entidade.localizacao %></td>
                <td><%= entidade.aprovada %></td>
                <td>
                  <ul class="list-unstyled mb-0 d-flex justify-content-end">
                    <li class="mr-3">
                      <a
                        href="/entidades/<%= entidade.id %>"
                        class="text-primary"
                        data-toggle="tooltip"
                        title=""
                        data-original-title="view"
                        ><i class="far fa-eye"></i
                      ></a>
                    </li>
                    <li class="mr-3">
                      <a
                        href="/entidades/<%= entidade.id %>/edit"
                        class="text-info"
                        data-toggle="tooltip"
                        title=""
                        data-original-title="Edit"
                        ><i class="fas fa-pencil-alt"></i
                      ></a>
                    </li>
                    <li>
                      <%- include("../partials/deleteForm", { url:
                      `/entidades/${entidade.id}` }) %>
                    </li>
                  </ul>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
